    },
    {
      "name": "Enter押下",
      "type": "press",
      "selectorType": "css",
      "selector": "#sb_form_q",
      "key": "Enter"
    },
    {
      "name": "待機",
      "type": "wait",
      "milliseconds": 3000
    },
    {
      "name": "スクショ",
      "type": "screenshot",
      "fileName": "user_value_result.png"
    }
  ]
