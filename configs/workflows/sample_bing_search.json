{
  "workflowKey": "sample_bing_search",
  "name": "Bing検索サンプル",
  "startUrl": "https://www.bing.com",
  "steps": [
    {
      "name": "検索ボックスへ入力",
      "type": "input",
      "selectorType": "css",
      "selector": "#sb_form_q",
      "valueFrom": "runtime.keyword"
    },
    {
      "name": "Enter押下",
      "type": "press",
      "selectorType": "css",
      "selector": "#sb_form_q",
      "key": "Enter"
    },
    {
      "name": "3秒待機",
      "type": "wait",
      "milliseconds": 3000
    },
    {
      "name": "スクショ保存",
      "type": "screenshot",
      "fileName": "bing_result.png"
    }
  ]
}